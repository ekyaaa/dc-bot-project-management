{
  "name": "discord-project-management-bot",
  "version": "1.0.0",
  "description": "Deterministic Discord Project Management Bot integrated with GitHub Issues, Projects v2, and Pull Requests",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@octokit/app": "^15.1.3",
    "@octokit/graphql": "^8.2.1",
    "@octokit/rest": "^21.1.1",
    "better-sqlite3": "^11.8.1",
    "croner": "^9.0.0",
    "discord.js": "^14.18.0",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
