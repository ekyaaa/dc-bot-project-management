# ==============================================================================
# Environment Configuration Template for Discord Project Management Bot
# Copy this file to .env and provide genuine values for your deployment.
# NEVER commit .env to source control!
# Sensitive values support *_FILE and *_PATH suffixes to read from Docker secrets or files.
# ==============================================================================

# Runtime
NODE_ENV=production
PORT=3000
TZ=Asia/Jakarta
PUBLIC_BASE_URL=https://bot.example.com

# Discord Application Credentials
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_GUILD_ID=123456789012345678
DISCORD_NOTIFICATION_CHANNEL_ID=123456789012345678
DISCORD_BOT_TOKEN=your-discord-bot-token-here
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# DISCORD_BOT_TOKEN_PATH=/path/to/discord_bot_token

# GitHub App Credentials
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.exampleclientid
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
# GITHUB_APP_CLIENT_SECRET_FILE=/run/secrets/github_app_client_secret
# GITHUB_APP_CLIENT_SECRET_PATH=/path/to/github_app_client_secret
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# GITHUB_WEBHOOK_SECRET_PATH=/path/to/github_webhook_secret

# GitHub App Private Key (PEM format, Docker secret, or host file path)
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
# Alternative alias: GITHUB_APP_PRIVATE_KEY_PEM_PATH=/run/secrets/github_app_private_key

# Target GitHub Repository & Project Binding
GITHUB_OWNER=your-org-or-username
GITHUB_REPOSITORY=your-repo-name
GITHUB_PROJECT_NUMBER=1

# Persistence (SQLite WAL database inside persistent volume /data)
DATABASE_PATH=/data/bot.db

# Token Encryption at Rest (32-byte key: 64 hex chars or 32 raw UTF-8 bytes)
# TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key
# Alternative alias: TOKEN_ENCRYPTION_KEY_PATH=/run/secrets/token_encryption_key

# Daily Digest Configuration
DIGEST_ENABLED=true
DIGEST_TIME=09:00
DIGEST_TIMEZONE=Asia/Jakarta

# Operational Safety Feature Flag (Set to true to allow write operations)
BOT_WRITE_ACTIONS_ENABLED=false

# Web Admin Dashboard Authentication
ADMIN_USERNAME=mashupsoat
# ADMIN_PASSWORD_HASH=salt:hexhash (Auto-configured for mashupsoat/password123 if omitted)
# ADMIN_SESSION_SECRET=your-random-32-character-secret-key
